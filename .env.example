APP_NAME=TutorTab
DEBUG=false

# --- application ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tutortab:tutortab@localhost:5432/tutortab
REDIS_URL=redis://localhost:6379/0

# --- docker-compose ---------------------------------------------------------
POSTGRES_USER=tutortab
POSTGRES_PASSWORD=tutortab
POSTGRES_DB=tutortab
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- telegram bot -----------------------------------------------------------
# Token from @BotFather. Required to run `python -m bot.main`.
TELEGRAM_BOT_TOKEN=
BOT_TIMEZONE=Europe/Moscow
# Bot username without the @, used to build parent invite links from the API.
BOT_USERNAME=

# --- mini app ---------------------------------------------------------------
# Public https address of the page served at /app. Telegram opens web_app
# buttons over https only, so http:// or an empty value hides the button.
# In development: `ngrok http 8000` and paste the https URL with /app.
MINIAPP_URL=

